#!/bin/sh
set -eu

# Update labels in isolinux/live.cfg and boot/grub/grub.cfg
for config in isolinux/live.cfg boot/grub/grub.cfg; do
    [ -f "$config" ] || continue
    sed -i \
        -e 's/Live system (amd64 fail-safe mode)/AETHER OS (Safe graphics mode)/g' \
        -e 's/Live system (amd64)/Try AETHER OS (Live Desktop)/g' \
        "$config"
done

# Add "Install AETHER OS" entry to isolinux/live.cfg if present
if [ -f "isolinux/live.cfg" ]; then
    if ! grep -q "Install AETHER OS" isolinux/live.cfg; then
        cat << 'EOF' >> isolinux/live.cfg

label live-install
	menu label ^Install AETHER OS
	linux /live/vmlinuz
	initrd /live/initrd.img
	append boot=live components quiet splash live-media=removable aether.installer=1
EOF
    fi
fi

# Add "Install AETHER OS" entry to boot/grub/grub.cfg if present
if [ -f "boot/grub/grub.cfg" ]; then
    if ! grep -q "Install AETHER OS" boot/grub/grub.cfg; then
        cat << 'EOF' >> boot/grub/grub.cfg

menuentry "Install AETHER OS" --hotkey=i {
	linux /live/vmlinuz boot=live components quiet splash live-media=removable aether.installer=1
	initrd /live/initrd.img
}
EOF
    fi
fi
