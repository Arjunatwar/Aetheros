#!/bin/sh
set -eu

# Update labels in isolinux/live.cfg and boot/grub/grub.cfg
for config in isolinux/live.cfg boot/grub/grub.cfg; do
    [ -f "$config" ] || continue
    sed -i \
        -e 's/Live system (amd64 fail-safe mode)/Install AETHER OS (Safe graphics mode)/g' \
        -e 's/Live system (amd64)/Install AETHER OS/g' \
        -e 's/Try AETHER OS (Live Desktop)/Install AETHER OS/g' \
        "$config"
done

# Add "AETHER OS (Troubleshooting & Rescue Console)" entry to boot/grub/grub.cfg if present
if [ -f "boot/grub/grub.cfg" ]; then
    if ! grep -q "Troubleshooting & Rescue" boot/grub/grub.cfg; then
        cat << 'EOF' >> boot/grub/grub.cfg

menuentry "AETHER OS (Troubleshooting & Rescue Console)" --hotkey=r {
	linux /live/vmlinuz boot=live components quiet splash live-media=removable aether.rescue=1
	initrd /live/initrd.img
}
EOF
    fi
fi
