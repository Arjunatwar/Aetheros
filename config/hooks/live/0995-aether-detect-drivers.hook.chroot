#!/bin/sh
# AETHER OS — Build-time hardware driver auto-detection hook
# Runs inside the chroot during lb build.
# 1. Probes PCI hardware visible in the BUILD environment (the WSL host's /proc)
# 2. Maps found hardware to Debian driver packages via the AETHER driver DB
# 3. Installs recommended drivers into the live image
# This runs BEFORE 0997-aether-chmod-bins so all packages land before icon caches.
set -eu

AETHER_LIB=/usr/lib/aether-os
DRIVER_DB="$AETHER_LIB/aether-driver-db.py"

echo "=== AETHER Driver Auto-Detect Hook ==="

# ── 1. Install core driver infrastructure ──────────────────────────────────
apt-get install -y --no-install-recommends \
    pciutils \
    usbutils \
    lshw \
    dkms \
    linux-headers-amd64 \
    || true

# ── 2. Virtual Machine Integration (VirtualBox, VMware, KVM/QEMU) ───────────
echo "Installing Virtual Machine drivers and tools..."
apt-get install -y --no-install-recommends \
    open-vm-tools \
    open-vm-tools-desktop \
    spice-vdagent \
    xserver-xorg-video-vmware \
    xserver-xorg-video-qxl \
    xserver-xorg-video-all \
    xserver-xorg-input-all \
    virtualbox-guest-additions-iso \
    || true

# ── 3. GPU firmware ────────────────────────────────────────────────────────
echo "Installing GPU firmware..."
apt-get install -y --no-install-recommends \
    firmware-amd-graphics \
    firmware-intel-graphics \
    xserver-xorg-video-amdgpu \
    xserver-xorg-video-intel \
    xserver-xorg-video-nouveau \
    intel-media-va-driver \
    || true

# ── 4. WiFi / network firmware ─────────────────────────────────────────────
echo "Installing WiFi firmware..."
apt-get install -y --no-install-recommends \
    firmware-iwlwifi \
    firmware-realtek \
    firmware-atheros \
    firmware-brcm80211 \
    firmware-misc-nonfree \
    || true

# ── 5. Audio firmware and tools ──────────────────────────────────────────
echo "Installing audio firmware and tools..."
apt-get install -y --no-install-recommends \
    firmware-sof-signed \
    alsa-firmware-loaders \
    alsa-utils \
    || true

# ── 6. Python-based driver probe (best-effort, build host may differ) ──────
if command -v python3 >/dev/null 2>&1 && [ -f "$DRIVER_DB" ]; then
    echo "Running AETHER driver probe..."
    python3 - <<'PYEOF'
import sys, subprocess, re, importlib.util

# Load driver DB
spec = importlib.util.spec_from_file_location(
    "aether_driver_db", "/usr/lib/aether-os/aether-driver-db.py"
)
mod = importlib.util.module_from_spec(spec)
sys.modules["aether_driver_db"] = mod
spec.loader.exec_module(mod)

def run(cmd):
    try:
        return subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True, timeout=10)
    except Exception:
        return ""

# Parse lspci -n for vendor/class IDs
devices = []
out_n = run(["lspci", "-n"])
out_v = run(["lspci"])
names = {}
for line in out_v.splitlines():
    m = re.match(r"^([\w:.]+)\s+(.+)", line)
    if m:
        names[m.group(1)] = m.group(2)

for line in out_n.splitlines():
    m = re.match(r"^([\w:.]+)\s+([0-9a-fA-F]{4}):\s+([0-9a-fA-F]{4}):([0-9a-fA-F]{4})", line)
    if m:
        slot, cls, vid, did = m.group(1), m.group(2), m.group(3), m.group(4)
        devices.append({
            "slot": slot, "class_id": cls.lower(),
            "vendor_id": vid.lower(), "device_id": did.lower(),
            "name": names.get(slot, ""),
        })

pkgs = mod.packages_for_devices(devices)
if pkgs:
    print("Driver packages recommended for this hardware:", sorted(pkgs))
    result = subprocess.run(
        ["apt-get", "install", "-y", "--no-install-recommends"] + sorted(pkgs),
        capture_output=True, text=True
    )
    if result.returncode == 0:
        print("All recommended driver packages installed.")
    else:
        print("Some packages failed (non-fatal):", result.stderr[-300:])
else:
    print("No additional driver packages detected.")
PYEOF
fi || true

# ── 7. Update initramfs so all firmware is included ────────────────────────
echo "Updating initramfs..."
update-initramfs -u -k all 2>/dev/null || true

echo "=== AETHER Driver Auto-Detect Hook: DONE ==="
