#!/bin/sh
# AETHER OS — ensure all binaries are executable, links are created, and icon caches are built.
set -eu

# Ensure all /usr/local/bin scripts are executable
chmod +x /usr/local/bin/* 2>/dev/null || true
chmod +x /usr/bin/aether-* 2>/dev/null || true
chmod +x /usr/lib/aether-os/* 2>/dev/null || true

# Symlink all cross-platform commands into /usr/bin so every tool finds them in minimal PATH
for cmd in \
    cls dir copy move del erase md rd ren type where attrib findstr fc comp \
    tracert start ver cmd powershell pwsh winget choco notepad explorer \
    calc control cleanmgr dxdiag sfc ipconfig tasklist taskkill systeminfo \
    open pbcopy pbpaste sw_vers say mdfind mdls diskutil brew softwareupdate \
    dscacheutil networksetup caffeinate osascript neofetch bat; do
    if [ -f "/usr/local/bin/$cmd" ] && [ ! -e "/usr/bin/$cmd" ]; then
        ln -sf "/usr/local/bin/$cmd" "/usr/bin/$cmd"
    fi
done

# Rebuild GTK icon caches so the Aether-Neon themes are picked up
gtk-update-icon-cache -f -t /usr/share/icons/Aether-Neon-Dark  2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/Aether-Neon-Light 2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor            2>/dev/null || true

echo "0997-aether-chmod-bins: done."
