#!/bin/sh
case "${1:-}" in
    install|add)
        shift
        echo "Chocolatey v2.3.0 [AETHER compatibility]: Installing $*..."
        exec sudo apt-get install -y "$@"
        ;;
    uninstall|remove)
        shift
        echo "Chocolatey v2.3.0 [AETHER compatibility]: Removing $*..."
        exec sudo apt-get remove -y "$@"
        ;;
    search|find)
        shift
        echo "Chocolatey v2.3.0 [AETHER compatibility]: Searching for $*..."
        exec apt-cache search "$@"
        ;;
    upgrade|update)
        shift
        echo "Chocolatey v2.3.0 [AETHER compatibility]: Upgrading packages..."
        sudo apt-get update && exec sudo apt-get upgrade -y "$@"
        ;;
    list)
        shift
        exec dpkg -l "$@"
        ;;
    info)
        shift
        exec apt-cache show "$@"
        ;;
    *)
        echo "Chocolatey v2.3.0 - AETHER Compatibility Shim"
        echo "Usage: choco [install|uninstall|search|upgrade|list|info] <package>"
        ;;
esac
