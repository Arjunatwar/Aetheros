#!/bin/sh
# Windows Remote Desktop Connection (mstsc) wrapper
if command -v remmina >/dev/null 2>&1; then
    exec remmina "$@"
elif command -v rdesktop >/dev/null 2>&1; then
    exec rdesktop "$@"
else
    echo "Remote Desktop client (remmina/rdesktop) can be installed via AETHER Store or apt." >&2
    exit 1
fi
