#!/usr/bin/env python3
"""AETHER OS - Windows taskkill compatibility shim."""
import sys
import subprocess
import os
import signal

def print_help():
    print("TASKKILL [/S system [/U username [/P [password]]]]")
    print("         { [/FI filter] [/PID processid | /IM imagename] } [/T] [/F]")
    print("\nDescription:")
    print("    This tool is used to terminate tasks by process id (PID) or image name.")
    print("\nParameter List:")
    print("    /PID  processid        Specifies the PID of the process to be terminated.")
    print("    /IM   imagename        Specifies the image name of the process to be terminated.")
    print("    /F                     Specifies to forcefully terminate the process(es).")
    print("    /?                     Displays this help message.")

def main():
    args = sys.argv[1:]
    if not args or "/?" in args or "-h" in args or "--help" in args:
        print_help()
        sys.exit(0)

    pid = None
    im = None
    force = False

    i = 0
    while i < len(args):
        arg = args[i]
        upper = arg.upper()
        if upper == "/PID" and i + 1 < len(args):
            pid = args[i+1]
            i += 2
        elif upper == "/IM" and i + 1 < len(args):
            im = args[i+1]
            i += 2
        elif upper == "/F":
            force = True
            i += 1
        else:
            if arg.isdigit() and pid is None:
                pid = arg
            elif im is None and not arg.startswith("/"):
                im = arg
            i += 1

    sig = signal.SIGKILL if force else signal.SIGTERM

    if pid:
        try:
            os.kill(int(pid), sig)
            print(f"SUCCESS: Sent termination signal to the process with PID {pid}.")
        except Exception as e:
            print(f"ERROR: The process with PID {pid} could not be terminated. Reason: {e}")
            sys.exit(1)
    elif im:
        cmd = ["pkill"]
        if force:
            cmd.append("-9")
        cmd.extend(["-f", im])
        res = subprocess.run(cmd)
        if res.returncode == 0:
            print(f"SUCCESS: The process \"{im}\" has been terminated.")
        else:
            print(f"ERROR: The process \"{im}\" not found.")
            sys.exit(1)
    else:
        print("ERROR: Invalid syntax. Specify /PID or /IM.")
        sys.exit(1)

if __name__ == "__main__":
    main()
