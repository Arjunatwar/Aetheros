#!/bin/sh
###
# AETHER OS Calamares Wrapper
# Handles mount points, scale factors, permissions, and fstab cleanup
###

# Ensure live medium mount point is accessible at /run/live/medium/live/filesystem.squashfs
if [ ! -f "/run/live/medium/live/filesystem.squashfs" ]; then
    if [ -f "/lib/live/mount/medium/live/filesystem.squashfs" ]; then
        mkdir -p /run/live/medium
        mount --bind /lib/live/mount/medium /run/live/medium 2>/dev/null || ln -sfn /lib/live/mount/medium /run/live/medium
    fi
fi

# Ensure /lib/live/mount/medium symlink exists if only /run/live/medium exists
if [ ! -d "/lib/live/mount/medium" ] && [ -d "/run/live/medium" ]; then
    mkdir -p /lib/live/mount
    ln -sfn /run/live/medium /lib/live/mount/medium 2>/dev/null || true
fi

# Stale file left behind by live-build that messes with partitioning
if [ -f /etc/fstab ]; then
    sudo mv /etc/fstab /etc/fstab.orig.calamares 2>/dev/null || true
fi

export QT_AUTO_SCREEN_SCALE_FACTOR=1

# Access control to run calamares as root for X11/XWayland
xhost +si:localuser:root 2>/dev/null || true
pkexec calamares "$@"
xhost -si:localuser:root 2>/dev/null || true

# Restore stale fstab
if [ -f /etc/fstab.orig.calamares ]; then
    sudo mv /etc/fstab.orig.calamares /etc/fstab 2>/dev/null || true
fi
