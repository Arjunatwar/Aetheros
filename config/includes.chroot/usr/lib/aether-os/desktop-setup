#!/bin/sh
# Apply the AETHER wallpaper once after XFCE and Xorg identify the monitors.
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
marker="$config_home/aether-os/desktop-setup-v2"
wallpaper=/usr/share/backgrounds/aether/aether-aurora.png

mkdir -p "$(dirname "$marker")"

if [ ! -e "$marker" ] && [ -r "$wallpaper" ]; then
    attempt=0
    monitors=""
    while [ "$attempt" -lt 12 ]; do
        monitors=$(xrandr --listmonitors 2>/dev/null | awk 'NR > 1 { name = $2; sub(/^[+*]+/, "", name); print name }' | sort -u)
        [ -n "$monitors" ] && break
        attempt=$((attempt + 1))
        sleep 1
    done

    if [ -n "$monitors" ]; then
        workspace_count=$(xfconf-query -c xfwm4 -p /general/workspace_count 2>/dev/null || printf '1')
        case "$workspace_count" in
            ''|*[!0-9]*) workspace_count=1 ;;
        esac
        [ "$workspace_count" -gt 0 ] || workspace_count=1

        while IFS= read -r monitor; do
            [ -n "$monitor" ] || continue
            workspace=0
            while [ "$workspace" -lt "$workspace_count" ]; do
                base="/backdrop/screen0/monitor$monitor/workspace$workspace"
                xfconf-query -c xfce4-desktop -p "$base/last-image" --create --type string --set "$wallpaper"
                xfconf-query -c xfce4-desktop -p "$base/image-style" --create --type int --set 5
                xfconf-query -c xfce4-desktop -p "$base/color-style" --create --type int --set 0
                workspace=$((workspace + 1))
            done
        done <<EOF
$monitors
EOF
        : > "$marker"
    fi
fi

# Apply themes and disable default desktop icons
xfconf-query -c xsettings -p /Net/IconThemeName -s "Aether-Neon-Dark" --create -t string >/dev/null 2>&1 || true
xfconf-query -c xfwm4 -p /general/theme -s "Aether-Aurora" --create -t string >/dev/null 2>&1 || true
xfconf-query -c xfwm4 -p /general/button_layout -s "|HMC" --create -t string >/dev/null 2>&1 || true

xfconf-query -c xfce4-desktop -p /desktop-icons/file-icons/show-home -s false --create -t bool >/dev/null 2>&1 || true
xfconf-query -c xfce4-desktop -p /desktop-icons/file-icons/show-filesystem -s false --create -t bool >/dev/null 2>&1 || true
xfconf-query -c xfce4-desktop -p /desktop-icons/file-icons/show-trash -s false --create -t bool >/dev/null 2>&1 || true
xfconf-query -c xfce4-desktop -p /desktop-icons/file-icons/show-removable -s false --create -t bool >/dev/null 2>&1 || true

# Helper to detect live installation media vs installed system
is_live() {
    [ -d /run/live/medium ] || [ -d /lib/live/mount/medium ] || grep -q "boot=live" /proc/cmdline 2>/dev/null
}

is_rescue() {
    grep -q "aether.rescue=1" /proc/cmdline 2>/dev/null || grep -q "aether.recovery=1" /proc/cmdline 2>/dev/null
}

# Stop legacy xfce4-panel and plank
killall -9 xfce4-panel >/dev/null 2>&1 || true
killall -9 plank >/dev/null 2>&1 || true

# If running on uninstalled live media and not rescue mode, launch AETHER Installer exclusively
if is_live && ! is_rescue; then
    killall -9 aether-top-bar >/dev/null 2>&1 || true
    killall -9 aether-dock >/dev/null 2>&1 || true
    if ! pgrep -f "aether-installer" >/dev/null 2>&1; then
        /usr/local/bin/aether-installer --fullscreen >/dev/null 2>&1 &
    fi
else
    # Running on installed system or explicit rescue mode: start top bar and dock
    if ! pgrep -f "aether-top-bar" >/dev/null 2>&1; then
        /usr/bin/aether-top-bar >/dev/null 2>&1 &
    fi
    if ! pgrep -f "aether-dock" >/dev/null 2>&1; then
        /usr/bin/aether-dock >/dev/null 2>&1 &
    fi
fi

# Start VM display auto-resize and clipboard sharing if in VirtualBox, VMware, or QEMU
if command -v spice-vdagent >/dev/null 2>&1 && ! pgrep -f "spice-vdagent" >/dev/null 2>&1; then
    spice-vdagent >/dev/null 2>&1 &
fi
if command -v vmware-user-suid-wrapper >/dev/null 2>&1; then
    vmware-user-suid-wrapper >/dev/null 2>&1 &
elif command -v vmtoolsd >/dev/null 2>&1 && ! pgrep -f "vmtoolsd" >/dev/null 2>&1; then
    vmtoolsd -n vmusr >/dev/null 2>&1 &
fi
if command -v VBoxClient-all >/dev/null 2>&1; then
    VBoxClient-all >/dev/null 2>&1 &
elif command -v VBoxClient >/dev/null 2>&1; then
    VBoxClient --clipboard >/dev/null 2>&1 &
    VBoxClient --checkhostversion >/dev/null 2>&1 &
    VBoxClient --seamless >/dev/null 2>&1 &
    VBoxClient --vmsvga >/dev/null 2>&1 &
fi

# Ensure audio outputs are unmuted
if command -v amixer >/dev/null 2>&1; then
    amixer set Master unmute 80% >/dev/null 2>&1 || true
    amixer set PCM unmute 80% >/dev/null 2>&1 || true
fi

xfdesktop --reload >/dev/null 2>&1 || true
python3 /usr/lib/aether-os/aether-apply-settings >/dev/null 2>&1 || true
: > "$marker"
exit 0

